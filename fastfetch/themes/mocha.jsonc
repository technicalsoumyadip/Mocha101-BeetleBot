{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii_mocha.txt",
        "type": "file",
        "position": "left",
        "padding": { "top": 2, "right": 6 }
    },
    "display": {
        "separator": " ",
        "color": "white",
        "key": { "width": 16 },
        "bar": {
            "char": { "elapsed": "", "total": " " },
            "border": { "open": "", "close": "" },
            "width": 15
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "\u001b[38;2;203;166;247mWelcome to Brewland\u001b[0m"
        },
        {
            "type": "custom",
            "format": "{#90}──────────────────────────────{#}"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;148;226;213m  SOFTWARE \u001b[90m──────────"
        },
        {
            "type": "os",
            "key": "\u001b[38;2;148;226;213m  ├─\u001b[38;2;250;179;135m  \u001b[38;2;249;226;175mOS",
            "format": "{2}"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;148;226;213m  ├─\u001b[38;2;250;179;135m  \u001b[38;2;249;226;175mKernel"
        },
        {
            "type": "wm",
            "key": "\u001b[38;2;148;226;213m  ├─\u001b[38;2;250;179;135m  \u001b[38;2;249;226;175mWM"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;148;226;213m  ╰─\u001b[38;2;250;179;135m  \u001b[38;2;249;226;175mPkgs"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[38;2;148;226;213m  HARDWARE \u001b[90m──────────"
        },
        {
            "type": "cpu",
            "key": "\u001b[38;2;148;226;213m  ├─\u001b[38;2;250;179;135m  \u001b[38;2;249;226;175mCPU"
        },
        {
            "type": "gpu",
            "key": "\u001b[38;2;148;226;213m  ├─\u001b[38;2;250;179;135m 󰢮 \u001b[38;2;249;226;175mGPU"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;148;226;213m  ├─\u001b[38;2;250;179;135m  \u001b[38;2;249;226;175mRAM"
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;148;226;213m  ╰─\u001b[38;2;250;179;135m  \u001b[38;2;249;226;175mDisk"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}