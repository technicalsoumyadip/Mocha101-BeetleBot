* {
    /* Base Palette (Catppuccin Latte) */
    bg-col:         #eff1f5E6;
    bg-col-light:   #e6e9ef;
    border-col:     #ccd0da;
    accent:         #8839ef;
    fg-col:         #4c4f69;
    fg-col2:        #d20f39;
    grey:           #acb0be;
    network:        #7287fd;
    bluetooth:      #dd7878;
    wallpaper:      #04a5e5;
    music:          #40a02b;

    /* Aliases for adi1090x-style templates */
    background:     @bg-col;
    background-alt: @bg-col-light;
    foreground:     @fg-col;
    selected:       @accent;

    width:          600;
    font:           "JetBrainsMono Nerd Font 13";
}