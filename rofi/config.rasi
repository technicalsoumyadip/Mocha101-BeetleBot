/* Config Layout */
@import "base.rasi"

configuration {
    show-icons:                  true;
}

window {
    width:                       750px;
    y-offset:                    0px;
}

mainbox {
    spacing:                     20px;
    padding:                     20px;
}

inputbar {
    spacing:                     10px;
    padding:                     12px 15px;
}

entry {
    placeholder:                 "Search...";
}

listview {
    enabled:                     true;
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                false;
    fixed-columns:               true;
}

element {
    padding:                     8px 15px;
    spacing:                     15px;
    orientation:                 horizontal;
}

element-icon {
    enabled:                     true;
    size:                        32px;
}

element-text {
    vertical-align:              0.5;
    horizontal-align:            0.0;
}
